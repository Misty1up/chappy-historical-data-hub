{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "git_commit",
    "node_version",
    "os",
    "symbol",
    "source",
    "source_adapter",
    "source_adapter_version",
    "requested_from_utc",
    "requested_to_utc",
    "acquisition_unit",
    "batch_size",
    "batch_pause_ms",
    "max_attempts",
    "retry_base_ms",
    "retry_jitter_ms",
    "total_days",
    "pass_days",
    "warn_days",
    "empty_days",
    "fail_days",
    "tick_count_total",
    "source_file_count",
    "first_timestamp_msc",
    "last_timestamp_msc",
    "daily_source_hashes",
    "source_hash_root",
    "integrity_status",
    "precision_status",
    "canonical_promotion_allowed",
    "phase_1_source_snapshot_only",
    "generated_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string"},
    "git_commit": {"type": "string"},
    "node_version": {"type": "string"},
    "os": {"type": "string"},
    "symbol": {"type": "string"},
    "source": {"const": "dukascopy"},
    "source_adapter": {"const": "dukascopy-node"},
    "source_adapter_version": {"const": "1.50.0"},
    "requested_from_utc": {"type": "string", "format": "date-time"},
    "requested_to_utc": {"type": "string", "format": "date-time"},
    "acquisition_unit": {"const": "UTC_DAY"},
    "batch_size": {"type": "integer", "minimum": 1},
    "batch_pause_ms": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "retry_base_ms": {"type": "integer", "minimum": 0},
    "retry_jitter_ms": {"type": "integer", "minimum": 0},
    "total_days": {"type": "integer", "minimum": 1},
    "pass_days": {"type": "integer", "minimum": 0},
    "warn_days": {"type": "integer", "minimum": 0},
    "empty_days": {"type": "integer", "minimum": 0},
    "fail_days": {"type": "integer", "minimum": 0},
    "tick_count_total": {"type": "integer", "minimum": 0},
    "source_file_count": {"type": "integer", "minimum": 0},
    "first_timestamp_msc": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "last_timestamp_msc": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "daily_source_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date_utc", "sha256"],
        "properties": {
          "date_utc": {"type": "string", "format": "date"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "source_hash_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "integrity_status": {"enum": ["PASS", "WARN", "INCOMPLETE"]},
    "precision_status": {"enum": ["UNVERIFIED", "VERIFIED"]},
    "canonical_promotion_allowed": {"const": false},
    "phase_1_source_snapshot_only": {"const": true},
    "generated_at_utc": {"type": "string", "format": "date-time"}
  }
}
