{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chappy.local/schemas/mt5_derivative_evidence.schema.json",
  "title": "MT5 Tick Derivative Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "symbol",
    "date_utc",
    "git_commit",
    "precision_status",
    "price_digits",
    "price_scale",
    "source_snapshot_sha256",
    "source_row_count",
    "canonical_row_count",
    "canonical_logical_row_sha256",
    "from_msc",
    "to_msc",
    "mt5_csv_path",
    "mt5_csv_physical_sha256",
    "mt5_csv_file_size_bytes",
    "mt5_contract_path",
    "mt5_contract_physical_sha256",
    "mt5_contract_file_size_bytes",
    "resumed_existing",
    "order_policy",
    "same_timestamp_policy",
    "dedupe_applied",
    "gap_fill_applied",
    "bid_ask_mapping",
    "volume_mapping_policy",
    "dataset_binding_status",
    "mqltick_import_helper"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "profile_id": { "const": "HDH_MT5_MQLTICK_CSV_V1" },
    "symbol": { "type": "string", "minLength": 1 },
    "date_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "git_commit": { "type": "string", "minLength": 1 },
    "precision_status": { "const": "VERIFIED" },
    "price_digits": { "type": "integer", "minimum": 0 },
    "price_scale": { "type": "integer", "minimum": 1 },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_row_count": { "type": "integer", "minimum": 1 },
    "canonical_row_count": { "type": "integer", "minimum": 1 },
    "canonical_logical_row_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "from_msc": { "type": "string", "pattern": "^\\d+$" },
    "to_msc": { "type": "string", "pattern": "^\\d+$" },
    "mt5_csv_path": { "type": "string", "pattern": "^mt5/ticks/[^/]+/\\d{4}/\\d{2}/\\d{4}-\\d{2}-\\d{2}\\.ticks\\.csv$" },
    "mt5_csv_physical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mt5_csv_file_size_bytes": { "type": "integer", "minimum": 1 },
    "mt5_contract_path": { "type": "string", "pattern": "^mt5/ticks/[^/]+/\\d{4}/\\d{2}/\\d{4}-\\d{2}-\\d{2}\\.contract\\.json$" },
    "mt5_contract_physical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mt5_contract_file_size_bytes": { "type": "integer", "minimum": 1 },
    "resumed_existing": { "type": "boolean" },
    "order_policy": { "const": "SOURCE_SEQ_PRESERVED_NONDECREASING_TIME" },
    "same_timestamp_policy": { "const": "PRESERVED" },
    "dedupe_applied": { "const": false },
    "gap_fill_applied": { "const": false },
    "bid_ask_mapping": { "const": "DIRECT_FROM_CANONICAL_SCALED" },
    "volume_mapping_policy": { "const": "UNMAPPED_BID_ASK_VOLUME_REMAINS_CANONICAL_ONLY" },
    "dataset_binding_status": { "const": "PENDING_P2_5_PACKET" },
    "mqltick_import_helper": { "const": "mt5/HDH_CustomTicksReplace_Import.mq5" }
  }
}
