{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "symbol", "from_utc", "to_utc", "out_dir", "batch_size", "batch_pause_ms", "max_attempts", "force"],
  "properties": {
    "task_id": {"type": "string"},
    "symbol": {"type": "string"},
    "from_utc": {"type": "string", "format": "date-time"},
    "to_utc": {"type": "string", "format": "date-time"},
    "out_dir": {"type": "string"},
    "batch_size": {"type": "integer", "minimum": 1},
    "batch_pause_ms": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "force": {"type": "boolean"}
  }
}
