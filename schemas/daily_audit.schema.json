{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date_utc",
    "requested_from_utc",
    "requested_to_utc",
    "status",
    "tick_count",
    "first_timestamp_msc",
    "last_timestamp_msc",
    "exact_duplicate_count",
    "same_timestamp_pair_count",
    "out_of_range_count",
    "out_of_order_count",
    "invalid_bid_count",
    "invalid_ask_count",
    "invalid_price_count",
    "negative_spread_count",
    "null_bid_volume_count",
    "null_ask_volume_count",
    "snapshot_path",
    "snapshot_sha256",
    "failure_class",
    "note"
  ],
  "properties": {
    "date_utc": {"type": "string", "format": "date"},
    "requested_from_utc": {"type": ["string", "null"], "format": "date-time"},
    "requested_to_utc": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["PASS", "WARN", "FAIL"]},
    "tick_count": {"type": "integer", "minimum": 0},
    "first_timestamp_msc": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "last_timestamp_msc": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "exact_duplicate_count": {"type": "integer", "minimum": 0},
    "same_timestamp_pair_count": {"type": "integer", "minimum": 0},
    "out_of_range_count": {"type": "integer", "minimum": 0},
    "out_of_order_count": {"type": "integer", "minimum": 0},
    "invalid_bid_count": {"type": "integer", "minimum": 0},
    "invalid_ask_count": {"type": "integer", "minimum": 0},
    "invalid_price_count": {"type": "integer", "minimum": 0},
    "negative_spread_count": {"type": "integer", "minimum": 0},
    "null_bid_volume_count": {"type": "integer", "minimum": 0},
    "null_ask_volume_count": {"type": "integer", "minimum": 0},
    "snapshot_path": {"type": ["string", "null"]},
    "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "failure_class": {
      "type": ["string", "null"],
      "enum": [
        "FETCH_FAILED",
        "UPSTREAM_EMPTY",
        "INVALID_PAYLOAD",
        "TIMESTAMP_OUT_OF_RANGE",
        "NON_MONOTONIC_INPUT",
        "INVALID_BID",
        "INVALID_ASK",
        "NEGATIVE_SPREAD",
        "CACHE_WRITE_FAILED",
        "HASH_MISMATCH",
        "UNEXPLAINED_ZERO_TICK",
        "EMPTY_UNCLASSIFIED",
        "UNKNOWN",
        null
      ]
    },
    "note": {"type": ["string", "null"]}
  }
}
