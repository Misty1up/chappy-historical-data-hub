{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chappy.local/schemas/control-state-v1.json",
  "title": "CHAPPY Development Control State export",
  "type": "object",
  "required": ["schema_version", "project_id", "sequence", "state", "authority", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "sequence": {"type": ["integer", "number", "string"]},
    "authority": {"type": "object"},
    "state": {
      "type": "object",
      "required": ["task_id", "current_actor", "status", "user_action_required", "next_actor", "blocked"],
      "properties": {
        "task_id": {"type": "string"},
        "current_actor": {"enum": ["USER", "CHAPPY", "CHAPPY_SYNC", "CODEX", "WAIT_CODEX", "CHAPPY_REVIEW", "DONE", "SYNC_REQUIRED"]},
        "status": {"type": "string"},
        "user_action_required": {"type": "boolean"},
        "next_actor": {"type": ["string", "null"]},
        "blocked": {"type": "array", "items": {"type": "string"}}
      }
    },
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
