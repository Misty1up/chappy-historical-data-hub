{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Misty1up/chappy-historical-data-hub/schemas/phase6_comparator_profile.schema.json","type":"object","additionalProperties":false,"required":["comparator_profile_schema_version","comparator_profile_id","comparator_profile_sha256","rules"],"properties":{"comparator_profile_schema_version":{"const":"HDH_P6_COMPARATOR_PROFILE_V1"},"comparator_profile_id":{"type":"string","minLength":1},"comparator_profile_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"rules":{"type":"array","items":{"$ref":"#/$defs/rule"}}},"$defs":{"rule":{"type":"object","additionalProperties":false,"required":["layer","field_path","comparator"],"properties":{"layer":{"enum":["INPUT","INDICATOR_FEATURE","SIGNAL","EXECUTION","RESULT"]},"field_path":{"type":"string","pattern":"^fields\\.[^*]+$"},"comparator":{"enum":["EXACT","ABSOLUTE","RELATIVE","ABS_OR_REL"]},"abs_tolerance":{"type":"number","minimum":0},"rel_tolerance":{"type":"number","minimum":0},"units":{"type":"string","minLength":1},"rationale":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"comparator":{"not":{"const":"EXACT"}}}},"then":{"properties":{"layer":{"enum":["INDICATOR_FEATURE","RESULT"]}},"required":["units","rationale"]}},{"if":{"properties":{"comparator":{"const":"ABSOLUTE"}}},"then":{"required":["abs_tolerance"]}},{"if":{"properties":{"comparator":{"const":"RELATIVE"}}},"then":{"required":["rel_tolerance"]}},{"if":{"properties":{"comparator":{"const":"ABS_OR_REL"}}},"then":{"anyOf":[{"required":["abs_tolerance"]},{"required":["rel_tolerance"]}]}}]}}}
