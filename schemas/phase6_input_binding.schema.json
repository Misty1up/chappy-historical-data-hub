{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Misty1up/chappy-historical-data-hub/schemas/phase6_input_binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_binding_schema_version", "binding_status", "handoff_schema_version", "registry_schema_version",
    "dataset_id", "symbol", "requested_from_utc", "requested_to_utc", "tick_count_total",
    "source_hash_root", "canonical_logical_hash_root", "parquet_file_hash_root", "mt5_derivative_hash_root",
    "price_digits", "price_scale", "canonical_contract", "packet_integrity", "local_paths", "numba", "mt5", "mutation_guard"
  ],
  "properties": {
    "input_binding_schema_version": {"const": "HDH_P6_INPUT_BINDING_V1"},
    "binding_status": {"const": "PASS"},
    "handoff_schema_version": {"const": "HDH_LOCAL_HANDOFF_V1"},
    "registry_schema_version": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "pattern": "^HDH_DATASET_V1_[0-9a-f]{64}$"},
    "symbol": {"type": "string", "minLength": 1},
    "requested_from_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "requested_to_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "tick_count_total": {"type": "integer", "minimum": 0},
    "source_hash_root": {"$ref": "#/$defs/sha256"},
    "canonical_logical_hash_root": {"$ref": "#/$defs/sha256"},
    "parquet_file_hash_root": {"$ref": "#/$defs/sha256"},
    "mt5_derivative_hash_root": {"$ref": "#/$defs/sha256"},
    "price_digits": {"type": "integer", "minimum": 0},
    "price_scale": {"type": "integer", "minimum": 1},
    "canonical_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_field", "timestamp_semantics", "source_order_field", "source_order_semantics", "exact_price_fields", "same_timestamp_policy"],
      "properties": {
        "timestamp_field": {"const": "timestamp_msc"},
        "timestamp_semantics": {"const": "UTC_UNIX_EPOCH_MILLISECONDS"},
        "source_order_field": {"const": "source_seq"},
        "source_order_semantics": {"const": "ORIGINAL_SOURCE_ORDER_PRESERVED"},
        "exact_price_fields": {"const": ["bid_scaled", "ask_scaled"]},
        "same_timestamp_policy": {"const": "PRESERVED"}
      }
    },
    "packet_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity_status", "canonical_promotion_allowed", "registry_verify_status", "packet_revalidation_status", "manifest_sha256", "sha256sums_sha256"],
      "properties": {
        "integrity_status": {"const": "PASS"},
        "canonical_promotion_allowed": {"const": true},
        "registry_verify_status": {"const": "PASS"},
        "packet_revalidation_status": {"const": "PASS"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "sha256sums_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "local_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_packet", "numba_dataset_json", "mt5_symbol_contract_json"],
      "properties": {
        "data_packet": {"type": "string", "minLength": 1},
        "numba_dataset_json": {"type": "string", "minLength": 1},
        "mt5_symbol_contract_json": {"type": "string", "minLength": 1}
      }
    },
    "numba": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_binding_status", "canonical_schema_version", "file_count", "row_count_total", "parquet_files"],
      "properties": {
        "dataset_binding_status": {"const": "BOUND_P2_5_PACKET"},
        "canonical_schema_version": {"const": "0.1"},
        "file_count": {"type": "integer", "minimum": 1},
        "row_count_total": {"type": "integer", "minimum": 0},
        "parquet_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}}
      }
    },
    "mt5": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_binding_status", "canonical_schema_version", "profile_id", "csv_columns", "mqltick_mapping", "order_policy", "same_timestamp_policy", "dedupe_applied", "gap_fill_applied", "bid_ask_mapping", "volume_mapping_policy", "file_count", "row_count_total", "tick_files"],
      "properties": {
        "dataset_binding_status": {"const": "BOUND_P2_5_PACKET"},
        "canonical_schema_version": {"const": "0.1"},
        "profile_id": {"const": "HDH_MT5_MQLTICK_CSV_V1"},
        "csv_columns": {"const": ["time_msc", "bid", "ask", "bid_scaled", "ask_scaled", "source_seq"]},
        "mqltick_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time", "time_msc", "bid", "ask", "last", "volume", "volume_real", "flags"],
          "properties": {
            "time": {"const": "floor(time_msc/1000)"},
            "time_msc": {"const": "DIRECT"},
            "bid": {"const": "DIRECT_CANONICAL_PRICE"},
            "ask": {"const": "DIRECT_CANONICAL_PRICE"},
            "last": {"const": "0"},
            "volume": {"const": "0"},
            "volume_real": {"const": "0"},
            "flags": {"const": "TICK_FLAG_BID|TICK_FLAG_ASK"}
          }
        },
        "order_policy": {"const": "SOURCE_SEQ_PRESERVED_NONDECREASING_TIME"},
        "same_timestamp_policy": {"const": "PRESERVED"},
        "dedupe_applied": {"const": false},
        "gap_fill_applied": {"const": false},
        "bid_ask_mapping": {"const": "DIRECT_FROM_CANONICAL_SCALED"},
        "volume_mapping_policy": {"const": "UNMAPPED_BID_ASK_VOLUME_REMAINS_CANONICAL_ONLY"},
        "file_count": {"type": "integer", "minimum": 1},
        "row_count_total": {"type": "integer", "minimum": 0},
        "tick_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}}
      }
    },
    "mutation_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_mutation_performed", "registry_mutation_performed", "terminal_mt5_mutation_performed", "strategy_evaluation_performed", "numba_mt5_parity_declared"],
      "properties": {
        "packet_mutation_performed": {"const": false},
        "registry_mutation_performed": {"const": false},
        "terminal_mt5_mutation_performed": {"const": false},
        "strategy_evaluation_performed": {"const": false},
        "numba_mt5_parity_declared": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_utc", "packet_relative_path", "local_path", "physical_sha256", "canonical_logical_row_hash", "source_snapshot_sha256", "row_count", "file_size_bytes"],
      "properties": {
        "date_utc": {"type": "string", "format": "date"},
        "packet_relative_path": {"type": "string", "minLength": 1},
        "local_path": {"type": "string", "minLength": 1},
        "physical_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_logical_row_hash": {"$ref": "#/$defs/sha256"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 0},
        "file_size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
