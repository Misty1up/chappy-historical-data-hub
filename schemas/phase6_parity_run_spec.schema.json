{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Misty1up/chappy-historical-data-hub/schemas/phase6_parity_run_spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parity_run_spec_schema_version",
    "parity_contract_version",
    "parity_run_id",
    "run_spec_status",
    "input_binding_schema_version",
    "dataset_id",
    "source_hash_root",
    "canonical_logical_hash_root",
    "parquet_file_hash_root",
    "mt5_derivative_hash_root",
    "tick_count_total",
    "symbol",
    "requested_from_utc",
    "requested_to_utc",
    "price_digits",
    "price_scale",
    "timestamp_semantics",
    "source_order_semantics",
    "same_timestamp_policy",
    "mt5_profile_id",
    "mt5_order_policy",
    "bid_ask_mapping",
    "volume_mapping_policy",
    "repository_commit",
    "numba_adapter_version",
    "mt5_adapter_version",
    "logic_contract_id",
    "logic_contract_sha256",
    "comparator_profile_id",
    "comparator_profile_sha256",
    "environment_versions",
    "output_evidence_root"
  ],
  "properties": {
    "parity_run_spec_schema_version": {"const": "HDH_P6_PARITY_RUN_SPEC_V1"},
    "parity_contract_version": {"const": "0.1"},
    "parity_run_id": {"type": "string", "pattern": "^HDH_P6_RUN_V1_[0-9a-f]{64}$"},
    "run_spec_status": {"const": "BOUND"},
    "input_binding_schema_version": {"const": "HDH_P6_INPUT_BINDING_V1"},
    "dataset_id": {"type": "string", "pattern": "^HDH_DATASET_V1_[0-9a-f]{64}$"},
    "source_hash_root": {"$ref": "#/$defs/sha256"},
    "canonical_logical_hash_root": {"$ref": "#/$defs/sha256"},
    "parquet_file_hash_root": {"$ref": "#/$defs/sha256"},
    "mt5_derivative_hash_root": {"$ref": "#/$defs/sha256"},
    "tick_count_total": {"type": "integer", "minimum": 0},
    "symbol": {"type": "string", "minLength": 1},
    "requested_from_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "requested_to_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "price_digits": {"type": "integer", "minimum": 0},
    "price_scale": {"type": "integer", "minimum": 1},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "numba_adapter_version": {"type": "string", "minLength": 1},
    "mt5_adapter_version": {"type": "string", "minLength": 1},
    "logic_contract_id": {"type": "string", "minLength": 1},
    "logic_contract_sha256": {"$ref": "#/$defs/sha256"},
    "comparator_profile_id": {"type": "string", "minLength": 1},
    "comparator_profile_sha256": {"$ref": "#/$defs/sha256"},
    "environment_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "output_evidence_root": {"type": "string", "minLength": 1},
    "timestamp_semantics": {"const": "UTC_UNIX_EPOCH_MILLISECONDS"},
    "source_order_semantics": {"const": "ORIGINAL_SOURCE_ORDER_PRESERVED"},
    "same_timestamp_policy": {"const": "PRESERVED"},
    "mt5_profile_id": {"const": "HDH_MT5_MQLTICK_CSV_V1"},
    "mt5_order_policy": {"const": "SOURCE_SEQ_PRESERVED_NONDECREASING_TIME"},
    "bid_ask_mapping": {"const": "DIRECT_FROM_CANONICAL_SCALED"},
    "volume_mapping_policy": {"const": "UNMAPPED_BID_ASK_VOLUME_REMAINS_CANONICAL_ONLY"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
