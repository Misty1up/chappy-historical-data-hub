{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Misty1up/chappy-historical-data-hub/schemas/numba_dataset_binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "dataset_binding_status", "canonical_schema_version", "symbol", "requested_from_utc", "requested_to_utc", "source_hash_root", "canonical_logical_hash_root", "price_digits", "price_scale", "parquet_files"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "dataset_id": {"type": "string", "pattern": "^HDH_DATASET_V1_[0-9a-f]{64}$"},
    "dataset_binding_status": {"const": "BOUND_P2_5_PACKET"},
    "canonical_schema_version": {"const": "0.1"},
    "symbol": {"type": "string"},
    "requested_from_utc": {"type": "string", "format": "date-time"},
    "requested_to_utc": {"type": "string", "format": "date-time"},
    "source_hash_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_logical_hash_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "price_digits": {"type": "integer", "minimum": 0},
    "price_scale": {"type": "integer", "minimum": 1},
    "parquet_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}}
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_utc", "path", "physical_sha256", "file_size_bytes", "canonical_logical_row_hash", "row_count", "source_snapshot_sha256"],
      "properties": {
        "date_utc": {"type": "string", "format": "date"},
        "path": {"type": "string", "pattern": "^canonical/"},
        "physical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "file_size_bytes": {"type": "integer", "minimum": 1},
        "canonical_logical_row_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "row_count": {"type": "integer", "minimum": 0},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
