{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Misty1up/chappy-historical-data-hub/schemas/phase6_mt5_trace_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version",
    "adapter_version",
    "probe_id",
    "probe_version",
    "status",
    "parity_run_id",
    "dataset_id",
    "source_hash_root",
    "canonical_logical_hash_root",
    "parquet_file_hash_root",
    "mt5_derivative_hash_root",
    "logic_contract_sha256",
    "canonical_symbol",
    "mt5_symbol",
    "tick_count_total",
    "first_timestamp_msc",
    "last_timestamp_msc",
    "price_digits",
    "price_scale",
    "trace_event_count",
    "layer_counts",
    "trade_count",
    "total_pnl_scaled",
    "trace_file",
    "trace_format",
    "trace_root_status",
    "source_seq_bridge",
    "environment_versions",
    "input_mutation",
    "canonical_reorder",
    "source_reacquisition",
    "automatic_terminal_mutation",
    "real_account_execution"
  ],
  "properties": {
    "report_schema_version": {"const": "HDH_P6_MT5_TRACE_REPORT_V1"},
    "adapter_version": {"const": "P6_MT5_REFERENCE_ADAPTER_V1"},
    "probe_id": {"const": "P6_REFERENCE_PARITY_PROBE_V1"},
    "probe_version": {"const": "1.0.0"},
    "status": {"const": "PASS"},
    "parity_run_id": {"type": "string", "pattern": "^HDH_P6_RUN_V1_[0-9a-f]{64}$"},
    "dataset_id": {"type": "string", "pattern": "^HDH_DATASET_V1_[0-9a-f]{64}$"},
    "source_hash_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_logical_hash_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parquet_file_hash_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mt5_derivative_hash_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logic_contract_sha256": {"const": "cb8fc63ce168100cede8e8475ef6f67dedde19fd1bc02ff51ff5b50b91d0a23b"},
    "canonical_symbol": {"type": "string", "minLength": 1},
    "mt5_symbol": {"type": "string", "minLength": 1},
    "tick_count_total": {"type": "integer", "minimum": 1},
    "first_timestamp_msc": {"type": "integer", "minimum": 0},
    "last_timestamp_msc": {"type": "integer", "minimum": 0},
    "price_digits": {"type": "integer", "minimum": 0, "maximum": 9},
    "price_scale": {"type": "integer", "minimum": 1},
    "trace_event_count": {"type": "integer", "minimum": 1},
    "layer_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["INPUT", "INDICATOR_FEATURE", "SIGNAL", "EXECUTION", "RESULT"],
      "properties": {
        "INPUT": {"type": "integer", "minimum": 1},
        "INDICATOR_FEATURE": {"type": "integer", "minimum": 1},
        "SIGNAL": {"type": "integer", "minimum": 0},
        "EXECUTION": {"type": "integer", "minimum": 0},
        "RESULT": {"type": "integer", "minimum": 1}
      }
    },
    "trade_count": {"type": "integer", "minimum": 0},
    "total_pnl_scaled": {"type": "integer"},
    "trace_file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.mt5_trace\\.jsonl$"},
    "trace_format": {"const": "JSONL_EVENT_PER_LINE_V1"},
    "trace_root_status": {"const": "COMPUTE_AFTER_INGEST"},
    "source_seq_bridge": {"const": "ZERO_BASED_PER_UTC_DAY_FROM_ACCEPTED_MT5_ROW_ORDER"},
    "environment_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_version", "terminal_build"],
      "properties": {
        "program_version": {"const": "1.00"},
        "terminal_build": {"type": "integer", "minimum": 1}
      }
    },
    "input_mutation": {"const": false},
    "canonical_reorder": {"const": false},
    "source_reacquisition": {"const": false},
    "automatic_terminal_mutation": {"const": false},
    "real_account_execution": {"const": false}
  }
}
