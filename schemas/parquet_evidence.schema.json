{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chappy.local/schemas/parquet_evidence.schema.json",
  "title": "Canonical Parquet Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "symbol",
    "date_utc",
    "git_commit",
    "precision_status",
    "price_digits",
    "price_scale",
    "source_snapshot_sha256",
    "source_row_count",
    "canonical_row_count",
    "canonical_logical_row_sha256",
    "parquet_generated",
    "parquet_path",
    "parquet_physical_sha256",
    "parquet_file_size_bytes",
    "parquet_resumed_existing",
    "writer_package",
    "writer_version",
    "reader_package",
    "reader_version",
    "profile",
    "readback_row_count",
    "readback_schema_match",
    "readback_semantic_rows_match",
    "readback_logical_row_sha256",
    "readback_logical_hash_match",
    "order_policy",
    "dedupe_applied",
    "gap_fill_applied"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "symbol": { "type": "string", "minLength": 1 },
    "date_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "git_commit": { "type": "string", "minLength": 1 },
    "precision_status": { "const": "VERIFIED" },
    "price_digits": { "type": "integer", "minimum": 0 },
    "price_scale": { "type": "integer", "minimum": 1 },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_row_count": { "type": "integer", "minimum": 0 },
    "canonical_row_count": { "type": "integer", "minimum": 0 },
    "first_timestamp_msc": { "type": ["string", "null"] },
    "last_timestamp_msc": { "type": ["string", "null"] },
    "canonical_logical_row_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parquet_generated": { "const": true },
    "parquet_path": { "type": "string", "pattern": "^canonical/[^/]+/\\d{4}/\\d{2}/\\d{4}-\\d{2}-\\d{2}\\.parquet$" },
    "parquet_physical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parquet_file_size_bytes": { "type": "integer", "minimum": 1 },
    "parquet_resumed_existing": { "type": "boolean" },
    "writer_package": { "const": "hyparquet-writer" },
    "writer_version": { "const": "0.16.8" },
    "reader_package": { "const": "hyparquet" },
    "reader_version": { "const": "1.29.2" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "codec", "statistics", "row_group_size", "dynamic_timestamp_metadata"],
      "properties": {
        "profile_id": { "const": "HDH_CANONICAL_SNAPPY_V1" },
        "codec": { "const": "SNAPPY" },
        "statistics": { "const": false },
        "row_group_size": { "const": 100000 },
        "dynamic_timestamp_metadata": { "const": false }
      }
    },
    "readback_row_count": { "type": "integer", "minimum": 0 },
    "readback_schema_match": { "const": true },
    "readback_semantic_rows_match": { "const": true },
    "readback_logical_row_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "readback_logical_hash_match": { "const": true },
    "order_policy": { "const": "SOURCE_SEQ_PRESERVED" },
    "dedupe_applied": { "const": false },
    "gap_fill_applied": { "const": false }
  }
}
