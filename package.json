{
  "name": "chappy-historical-data-hub",
  "version": "0.1.0",
  "description": "Canonical Dukascopy historical tick data hub for reproducible Numba/MT5 parity research",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm run build && node dist/scripts/build-web.js",
    "verify:web-static": "node dist/scripts/verify-web-static.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node dist/scripts/run-unit-tests.js",
    "hdh": "node dist/src/cli.js",
    "precision": "node dist/src/precision-cli.js",
    "canonical": "node dist/src/canonical-cli.js",
    "parquet": "node dist/src/parquet-cli.js",
    "mt5": "node dist/src/mt5-cli.js",
    "packet": "node dist/src/packet-cli.js",
    "local": "node dist/src/local-entry.js"
  },
  "dependencies": {
    "dukascopy-node": "1.50.0",
    "hyparquet": "1.29.2",
    "hyparquet-writer": "0.16.8",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@types/node": "18.17.0",
    "typescript": "5.9.3"
  }
}
